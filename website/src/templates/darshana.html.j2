{% extends "base.html.j2" %}
{% block body %}

<section class="chamber" style="min-height:72vh">
  <h1 class="sutra gilt" lang="sa">ऋतम्भरेश्वर</h1>
  <div class="bhashya">THE LORD WHO BEARS THE ORDER OF THE WORLD</div>
  <p class="plain">You have walked around the rising mandir; this is the innermost chamber.
     The approach below is the mark's own contraction — everything He bears falls away
     until only He remains.</p>
</section>

{# ── the approach: static stacked sequence by default (and under reduced motion);
     JS + motion upgrades to the pinned contraction ── #}
<div class="approach" id="approach">

  <div class="approach-static">
    <figure class="fig">
      <img src="{{ root }}assets/icons/rtam-chakra-garbhagriha.svg" alt="" width="280" height="280">
      <figcaption class="acap">
        <div class="dn" lang="sa">ऋत चक्र</div>
        <div class="en">THE LORD BEARING THE COSMIC ORDER</div>
        <div class="sub">the lotus seated among the twelve Ādityas — the wheel of order He bears</div>
      </figcaption>
    </figure>
    <figure class="fig">
      <img src="{{ root }}assets/icons/rtam-anahata-garbhagriha.svg" alt="" width="280" height="280">
      <figcaption class="acap">
        <div class="dn" lang="sa">अनाहत</div>
        <div class="en">THE LORD IN YOUR HEART</div>
        <div class="sub">the rim and the suns depart; the twelve-petal heart-lotus remains</div>
      </figcaption>
    </figure>
    <figure class="fig">
      <img src="{{ root }}assets/icons/rtam-bindu-garbhagriha.svg" alt="" width="280" height="280">
      <figcaption class="acap">
        <div class="dn" lang="sa">केवलम्</div>
        <div class="en">THE LORD ALONE</div>
        <div class="sub">the corolla folds — the single gold point, the same point beneath the Ṛ of ṚTAM</div>
      </figcaption>
    </figure>
  </div>

  <div class="approach-stage" aria-hidden="true">
    <div class="pin">
      <svg viewBox="0 0 600 600">
        <defs>
          <radialGradient id="glow" cx="50%" cy="50%" r="50%">
            <stop class="gs" offset="0%" stop-opacity=".55"/>
            <stop class="gs" offset="55%" stop-opacity=".14"/>
            <stop class="gs" offset="100%" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <circle id="glowC" cx="300" cy="300" r="120" fill="url(#glow)"/>
        <g id="rimG"><circle class="arim" cx="300" cy="300" r="234" stroke-width="36.2"/></g>
        <g id="winG"></g>
        <circle id="binduRing" class="aring" cx="300" cy="300" r="86" stroke-width="7" opacity="0"/>
        <g id="petG"></g>
        <circle id="hub" class="ahub" cx="300" cy="300" r="55.4"/>
      </svg>
      <div class="caps">
        <div class="acap" id="capC"><div class="dn" lang="sa">ऋत चक्र</div>
          <div class="en">THE LORD BEARING THE COSMIC ORDER</div>
          <div class="sub">the lotus seated among the twelve Ādityas</div></div>
        <div class="acap" id="capB"><div class="dn" lang="sa">अनाहत</div>
          <div class="en">THE LORD IN YOUR HEART</div>
          <div class="sub">the rim departs; the heart-lotus remains</div></div>
        <div class="acap" id="capA"><div class="dn" lang="sa">केवलम्</div>
          <div class="en">THE LORD ALONE</div>
          <div class="sub">the single gold point beneath the Ṛ of ṚTAM</div></div>
      </div>
      <div class="hint" id="aphint">SCROLL — EVERYTHING HE BEARS FALLS AWAY</div>
    </div>
  </div>

</div>

{# ── the murti viewing: one stage, three positions ── #}
<section class="reading" style="padding-top:14vh">
  <div class="k center">THE MURTI · ONE STAGE, THREE POSITIONS</div>

  <div class="murti" style="margin-top:34px">
    <div class="frame">
      <div class="pos" data-pos="sammukha">
        <img class="sheet" src="{{ root }}assets/geometry/front-elevation.svg"
             alt="Construction drawing of the sanctum, front elevation — the Shivling on its Jaladhari, the water rim, the nālī leaving north" width="1200" height="1500">
        <p class="cap">THE SANCTUM, AS DESIGNED — A PHOTOGRAPH STANDS HERE AFTER PRĀṆA-PRATIṢṬHĀ</p>
      </div>
      <div class="pos" data-pos="urdhvam">
        <img class="mark" src="{{ root }}assets/icons/rtam-chakra-garbhagriha.svg"
             alt="The ṛta-chakra — the mark seen from above" width="220" height="220">
        <p class="cap">FROM ABOVE — TWELVE PETALS, TWELVE SUNS, ONE CENTER</p>
      </div>
      <div class="pos" data-pos="antah">
        <img class="mark" src="{{ root }}assets/icons/rtam-anahata-garbhagriha.svg"
             alt="The anāhata — the mark seen from within" width="220" height="220">
        <p class="cap">FROM WITHIN — THE HEART-LOTUS, THE LORD SEATED WHERE YOU ARE</p>
      </div>
    </div>
    <div class="postabs" role="tablist" aria-label="the three positions">
      <button class="postab" type="button" role="tab" data-pos="sammukha" aria-selected="true"><span class="dn" lang="sa">सम्मुख</span>STAND BEFORE IT</button>
      <button class="postab" type="button" role="tab" data-pos="urdhvam" aria-selected="false"><span class="dn" lang="sa">ऊर्ध्वम्</span>FROM ABOVE</button>
      <button class="postab" type="button" role="tab" data-pos="antah" aria-selected="false"><span class="dn" lang="sa">अन्तः</span>FROM WITHIN</button>
    </div>
  </div>

  <div class="preads">
    <div class="pread on" data-pos="sammukha">
      <p class="plain center">The front elevation, drawn from the measured geometry: the
         <strong>Shivling</strong> rising from the lotus of the <strong>Jaladhari</strong>,
         the water rim of seven vessels, the nālī carrying the abhiṣeka waters out north.
         Read as Sāṅkhya, its tiers count twenty-four tattvas — and the twenty-fifth,
         consciousness itself, is the still center they surround.</p>
    </div>
    <div class="pread" data-pos="urdhvam">
      <p class="plain center">Seen from above, the mark is the <strong>ṛta-chakra</strong>:
         twelve petals inside twelve suns — the Ādityas, the months, the wheel of cosmic
         order the Lord bears. This is the reading the year-wheel and the plan-view carry.</p>
    </div>
    <div class="pread" data-pos="antah">
      <p class="plain center">Seen from within, the same mark is the <strong>anāhata</strong> —
         the twelve-petal heart-lotus of the subtle body. The Lord who bears the cosmic order
         is seated in your own chest; the walk outside and the seat inside are one geometry.</p>
    </div>
  </div>
</section>

{# ── the triad ── #}
<section class="chamber" style="min-height:64vh">
  <p class="sutra" style="font-size:clamp(24px,3vw,34px)" lang="hi"><span style="white-space:nowrap">वह
     संसार चलाता है</span> · <span style="white-space:nowrap">वह तुम्हारे हृदय में रहता है</span> ·
     <span style="white-space:nowrap">वह दोनों से परे है</span></p>
  <div class="bhashya" style="line-height:2.2"><span style="white-space:nowrap">HE RUNS THE
     WORLD</span> · <span style="white-space:nowrap">HE DWELLS IN YOUR HEART</span> ·
     <span style="white-space:nowrap">HE IS BEYOND BOTH</span></div>
</section>

{# ── the point that contains the land ── #}
<section class="chamber">
  <p class="sutra" style="font-size:clamp(22px,3vw,32px)" lang="sa">क्षेत्रज्ञं चापि मां विद्धि</p>
  <div class="bhashya">KNOW ME ALSO AS THE KNOWER OF THE FIELD</div>
  <p class="k" style="margin-top:10px"><span lang="sa" style="font-family:Tiro,serif; font-size:14px; letter-spacing:.08em">भगवद्गीता · अध्याय १३</span></p>
  <a class="bindu-end" href="{{ root }}" aria-label="the point that contains the land you came from" style="margin-top:56px"></a>
  <p class="k" style="margin-top:48px">TOUCH THE POINT — IT CONTAINS THE LAND YOU CAME FROM</p>
</section>

{% endblock %}

{% block page_js %}
<script src="{{ root }}assets/darshana.js"></script>
<script>rtamDarshana();</script>
{% endblock %}
