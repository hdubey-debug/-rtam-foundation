{% extends "base.html.j2" %}
{% block body %}

<section class="chamber" style="min-height:72vh">
  <h1 class="sutra" lang="hi">सेवा</h1>
  <div class="bhashya">OFFER, QUIETLY</div>
  <p class="plain">The hall is where the mandir is carried — annadāna, śilā-dāna, nitya-pūjā.
     Everything here is an offering, so nothing here shouts.
     [The stones are being set — S6.]</p>
  <p style="margin-top:44px" id="offer"><a class="flame" href="{{ site.donation.url if site.donation.url else '#offer' }}"><span class="dn" lang="hi">सेवा अर्पित करें</span> · OFFER SEVA</a></p>
  <p class="k" style="margin-top:20px">{{ site.donation.provider }} — HOSTED CHECKOUT</p>
</section>

<section class="chamber" style="min-height:50vh">
  <div class="sutra" style="font-size:clamp(28px,3.6vw,40px)" lang="sa">{{ seva.sankalpa_dn }}</div>
  <div class="bhashya">{{ seva.sankalpa_en }}</div>
</section>

{% endblock %}
